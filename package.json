{
  "name": "atelier-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/main.ts",
    "check": "tsc --noEmit && node --check app.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "node --import tsx scripts/verify-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.326",
    "diff": "9.0.0",
    "markdown-it": "15.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
