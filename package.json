{
  "name": "atelier-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "dev": "vite --config frontend/vite.config.ts",
    "format": "prettier --write \"{server,shared,scripts,tests}/**/*.{ts,js,mjs}\" package.json tsconfig.json .prettierrc.json \"frontend/**/*.{tsx,ts,css,html,json}\"",
    "format:check": "prettier --check \"{server,shared,scripts,tests}/**/*.{ts,js,mjs}\" package.json tsconfig.json .prettierrc.json \"frontend/**/*.{tsx,ts,css,html,json}\"",
    "check": "tsc --noEmit && tsc -p frontend/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts && npm run test:frontend",
    "test:live": "node --import tsx scripts/verify-live.ts",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/main.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "prestart": "npm run build",
    "test:frontend": "TSX_TSCONFIG_PATH=frontend/tsconfig.json node --import tsx --test frontend/src/features/*/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.326",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@reduxjs/toolkit": "2.14.0",
    "@streamdown/mermaid": "1.0.4",
    "@tanstack/react-query": "5.108.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "lucide-react": "1.75.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "streamdown": "2.8.0",
    "tailwind-merge": "3.7.0",
    "yaml": "2.8.3",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
