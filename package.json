{
  "name": "atelier-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "dev": "vite --config frontend/vite.config.ts",
    "format": "prettier --write \"{desktop,server,shared,scripts,tests}/**/*.{ts,mts,cts,js,mjs}\" packages/markdown/scripts/*.mts package.json \"tsconfig*.json\" .prettierrc.json \"frontend/**/*.{tsx,ts,css,html,json}\"",
    "format:check": "prettier --check \"{desktop,server,shared,scripts,tests}/**/*.{ts,mts,cts,js,mjs}\" packages/markdown/scripts/*.mts package.json \"tsconfig*.json\" .prettierrc.json \"frontend/**/*.{tsx,ts,css,html,json}\"",
    "check": "npm run check:architecture && npm run check:query && tsc --noEmit && tsc -p frontend/tsconfig.json && npm run check:desktop && npm run check:tools",
    "test": "node --import tsx --test tests/*.test.ts && npm run test:frontend",
    "test:live": "node --import tsx scripts/verify-live.ts",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/main.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "prestart": "npm run build",
    "test:frontend": "TSX_TSCONFIG_PATH=frontend/tsconfig.json node --import tsx --test frontend/src/features/*/*.test.ts",
    "build:markdown": "npm run build --workspace @atelier/markdown",
    "pack:markdown": "mkdir -p .local/packages && npm pack --workspace @atelier/markdown --pack-destination .local/packages",
    "predev": "npm run build:markdown && npm run prepare:preview",
    "precheck": "npm run build:markdown",
    "prebuild": "npm run build:markdown && npm run prepare:preview",
    "prepare:preview": "cd frontend && node ../node_modules/@lamberl-lee/file-preview/scripts/copy-pdf-worker.mjs",
    "desktop": "electron dist/desktop/main.mjs",
    "predesktop": "npm run check:desktop && npm run build && npm run build:desktop",
    "check:architecture": "tsx scripts/check-architecture.mts",
    "check:desktop": "tsc -p tsconfig.desktop.json",
    "check:tools": "tsc -p tsconfig.tools.json",
    "build:desktop": "tsx scripts/build-desktop.mts",
    "package:linux": "tsx scripts/linux/package.mts",
    "prepackage:linux": "npm run check && npm run build",
    "smoke:linux": "tsx scripts/smoke-linux.mts",
    "check:query": "tsx scripts/check-query-boundaries.mts",
    "check:headers": "tsx scripts/check-file-headers.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.326",
    "@atelier/markdown": "0.1.0",
    "@lamberl-lee/file-preview": "0.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@reduxjs/toolkit": "2.14.0",
    "@tanstack/react-query": "5.108.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "lucide-react": "1.75.0",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "tailwind-merge": "3.7.0",
    "yaml": "2.8.3",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "7.29.14",
    "@babel/types": "7.29.14",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.66.0-alpha-2026-11-18",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "workspaces": [
    "packages/markdown"
  ]
}
