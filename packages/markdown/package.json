{
  "name": "@atelier/markdown",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && tsx scripts/build-css-types.mts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@streamdown/cjk": "1.0.5",
    "@streamdown/code": "2.0.1",
    "@streamdown/math": "1.0.4",
    "@streamdown/mermaid": "1.0.4",
    "katex": "0.16.47",
    "streamdown": "2.8.0"
  }
}
