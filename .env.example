# The application binds only to loopback. No provider secrets belong in browser code.
ATELIER_PORT=4317
ATELIER_GATEWAY=http://127.0.0.1:3001
ATELIER_MODEL=gpt-6.1-sol
# Shunt owns its upstream OAuth credentials; this is only the local gateway placeholder.
ATELIER_GATEWAY_TOKEN=local-placeholder
# Optional absolute data directory; default: .data inside this project.
# ATELIER_DATA_DIR=/absolute/private/atelier-data

# Paired Linux desktop defaults for ordinary new sessions.
# ATELIER_NATIVE_EXECUTION=1
# ATELIER_HARNESS_PROGRESS=feedback
